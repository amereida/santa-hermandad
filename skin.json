{
	"manifest_version": 2,
	"name": "Stellamereida",
	"namemsg": "skinname-stellamereida",
	"version": "0.9.3",
	"author": [
		"[https://herbertspencer.net Herbert Spencer González]",
		".:TIG:. Taller de Investigaciones Gráficas, e[ad] Escuela de Arquitectura y Diseño, Pontificia Universidad Católica de Valparaíso",
		"Corporación Cultural Amereida"
	],
	"url": "https://github.com/amereida/stellamereida",
	"descriptionmsg": "stellamereida-desc",
	"license-name": "Artistic-2.0",
	"type": "skin",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"config": {
		"StellamereidaIsotypePath": {
			"value": null,
			"description": "Ruta ABSOLUTA en el sistema de archivos del servidor a un SVG monocromo colorizable (usa currentColor) para el isotipo/wordmark del header. El skin lo lee e inyecta inline, por lo que se tematiza claro/oscuro. Si es null o el archivo no es legible, usa el bundle resources/casiopea.svg. Ver README (seccion \"Logo / isotipo\")."
		},
		"StellamereidaIconPath": {
			"value": null,
			"description": "Ruta ABSOLUTA en el sistema de archivos del servidor al glifo compacto (cuadrado, sin wordmark) para viewports estrechos y la barra de pantalla completa. Mismas reglas que StellamereidaIsotypePath; fallback al bundle resources/casiopea-icon.svg."
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Skins\\Stellamereida\\": "includes/"
	},
	"ValidSkinNames": {
		"stellamereida": {
			"class": "MediaWiki\\Skins\\Stellamereida\\SkinStellamereida",
			"args": [
				{
					"name": "stellamereida",
					"responsive": true,
					"templateDirectory": "includes/templates",
					"styles": [],
					"scripts": [
						"skins.stellamereida.scripts"
					],
					"messages": [
						"sitetitle",
						"searchbutton",
						"tagline",
						"toc",
						"stellamereida-skip-to-content",
						"stellamereida-skip-to-nav",
						"stellamereida-sidebar",
						"stellamereida-home",
						"stellamereida-escape",
						"stellamereida-menu",
						"stellamereida-mainpage",
						"stellamereida-search",
						"stellamereida-thispage",
						"stellamereida-user",
						"stellamereida-temp-account",
						"stellamereida-managed-nav",
						"stellamereida-pagetools",
						"stellamereida-nav",
						"stellamereida-page",
						"stellamereida-close",
						"stellamereida-auto",
						"stellamereida-pref-theme",
						"stellamereida-theme-light",
						"stellamereida-theme-dark",
						"stellamereida-pref-font",
						"stellamereida-sz-s",
						"stellamereida-sz-m",
						"stellamereida-sz-l",
						"stellamereida-pref-family",
						"stellamereida-family-sans",
						"stellamereida-family-serif",
						"stellamereida-tools"
					],
					"menus": [
						"user-menu",
						"user-interface-preferences",
						"notifications",
						"views",
						"actions",
						"namespaces",
						"associated-pages",
						"variants"
					]
				}
			]
		}
	},
	"MessagesDirs": {
		"Stellamereida": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"StellamereidaMagic": "Stellamereida.i18n.magic.php"
	},
	"Hooks": {
		"GetDoubleUnderscoreIDs": "MediaWiki\\Skins\\Stellamereida\\Hooks::onGetDoubleUnderscoreIDs",
		"OutputPageParserOutput": "MediaWiki\\Skins\\Stellamereida\\Hooks::onOutputPageParserOutput",
		"GetPreferences": "MediaWiki\\Skins\\Stellamereida\\Hooks::onGetPreferences",
		"UserGetDefaultOptions": "MediaWiki\\Skins\\Stellamereida\\Hooks::onUserGetDefaultOptions",
		"BeforePageDisplay": "MediaWiki\\Skins\\Stellamereida\\Hooks::onBeforePageDisplay",
		"ResourceLoaderRegisterModules": "MediaWiki\\Skins\\Stellamereida\\Hooks::onResourceLoaderRegisterModules"
	},
	"_comment_ResourceModules": "skins.stellamereida.styles y .scripts se registran en PHP (Hooks::onResourceLoaderRegisterModules) con remoteSkinPath calculado de la carpeta REAL del skin (robusto al nombre del directorio al clonar). Ademas, `styles` esta vacio a proposito: la CSS critica del skin NO la carga MediaWiki en su <link> combinado (que va SIN version y se cachea rancio tras cada deploy), sino Hooks::onBeforePageDisplay con un <link> propio cuyo `version` es el hash de contenido de RL → caché larga inmutable + bust automático en cada cambio de CSS, sin acceso al servidor.",
